# Environment configuration (spec 007 FR-008). Copy to `.env` for local dev and fill in values.
# The SAME code runs in every environment — only these values differ (local ≠ prod). NO secret goes
# in git: in the cloud, DB creds + the Anthropic key come from AWS Secrets Manager (FR-007), and S3
# uses the IAM task role (leave the S3_ACCESS_* / S3_ENDPOINT_URL unset in prod).

# --- App / API ---
API_PORT=8000
ENVIRONMENT=local            # local | prod
LOG_LEVEL=info

# --- Postgres ---
POSTGRES_HOST=localhost      # local: localhost | container: db | prod: the RDS endpoint (from the secret)
POSTGRES_PORT=5432
POSTGRES_DB=wbhealth
POSTGRES_USER=wbhealth
POSTGRES_PASSWORD=           # local only; prod injects this from Secrets Manager
# Used by Alembic migrations (deploy step). Local: assemble from the vars above.
DATABASE_URL=postgresql+psycopg://wbhealth:PASSWORD@localhost:5432/wbhealth

# --- Object store (raw zone) ---
# LOCAL: point at MinIO with its static keys.  PROD: leave ALL THREE UNSET → boto3 uses AWS's default
# endpoint + the IAM task role (spec 007 FR-004). S3_BUCKET_RAW is the bucket name in both.
S3_ENDPOINT_URL=http://localhost:9000    # host tools; compose overrides the container to http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RAW=raw

# --- Model artifact store (spec 007 FR-006) ---
# LOCAL: unset → backend/models/.  PROD: s3://<artifacts-bucket>/models
MODEL_ARTIFACT_DIR=

# --- LLM (spec 004 / 008) ---
ANTHROPIC_API_KEY=           # local only; prod injects from Secrets Manager
ANTHROPIC_MODEL=claude-sonnet-4-5
ASK_MODEL=claude-sonnet-4-5  # the /ask champion (spec 008 FR-014); change to adopt a new selection

# --- CORS (defense-in-depth; the SPA is same-origin via CloudFront in prod) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (build-time) ---
# LOCAL: http://localhost:8000/api/v1.  PROD (static export behind CloudFront): /api/v1 (same-origin).
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
