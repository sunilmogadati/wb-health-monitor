# wb-health-monitor — local environment template.
# Copy to `.env` and fill in. Never commit `.env`. All values below are placeholders.

# --- Host port overrides (compose maps these to the standard in-container ports) ---
API_PORT=8000
POSTGRES_PORT=5432

# --- Environment ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Full SQLAlchemy URL used by the app and by alembic (env.py reads this).
DATABASE_URL=

# --- HTTP ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=

# --- Connection pool ---
DB_POOL_MAX=
DB_POOL_OVERFLOW=
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=
DB_POOL_RECYCLE_SECONDS=

# --- Object storage (MinIO — S3-compatible; the "raw" data landing zone) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# How the ingest code reaches MinIO from inside the stack (service name, not localhost):
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RAW=raw

# --- AI insights (spec 004) ---
# Optional. Unset -> GET /api/v1/ask runs a deterministic offline fallback (no network/keys needed).
ANTHROPIC_API_KEY=
